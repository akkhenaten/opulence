        {
          "value": "ssp",
          "label": "Statutory Sick Pay only"
        },
        {
          "value": "company",
          "label": "Company sick pay"
        }
      ]
    },
    {
      "id": "sick.company_terms",
      "label": "Company sick pay",
      "section": "sickness",
      "type": "textarea",
      "showIf": {
