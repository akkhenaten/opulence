    {
      "id": "pay.salary",
      "label": "Annual salary",
      "section": "pay",
      "type": "money",
      "help": "Gross, before deductions.",
      "showIf": {
        "q": "pay.basis",
        "eq": "salary"
      }
    },
    {
      "id": "pay.frequency",
      "label": "Paid",
      "section": "pay",
      "type": "choice",
      "options": [
        {
          "value": "weekly",
          "label": "Weekly",
          "text": "weekly"
        },
        {
          "value": "fortnightly",
          "label": "Every two weeks",
