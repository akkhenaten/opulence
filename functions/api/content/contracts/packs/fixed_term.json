    {
      "id": "place.address",
      "label": "Place of work",
      "section": "place",
      "type": "text",
      "showIf": {
        "q": "place.type",
        "eq": "fixed"
      }
    },
    {
      "id": "place.area",
      "label": "Area of work",
      "section": "place",
