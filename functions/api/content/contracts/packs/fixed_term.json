{
  "id": "fixed_term",
  "version": 1,
  "title": "Fixed-term employment",
  "summary": "An employee for a set period, a task or an event (for example event cover, a client contract or maternity cover), full-time or part-time.",
  "party": "person",
  "engagement_type": "employee",
  "doc_title": "Fixed-term Contract of Employment",
  "jurisdictions": [
    "ew",
    "sc",
    "ni"
  ],
  "law": [
    "fte-regs-2002",
    "fte-regs-ni-2002",
    "fixed-term-expiry-dismissal",
    "fixed-term-expiry-dismissal-ni",
    "era2025-unfair-dismissal-six-months",
    "era2025-flexible-working",
    "ni-good-jobs-bill"
  ],
  "decision": {
    "hint": "An employee you control and pay through payroll, needed only until a known date, a task is finished or an event happens (if the need is open-ended, use the permanent pack)."
  },
  "sections": [
    {
      "id": "parties",
      "title": "Parties"
    },
    {
      "id": "term",
      "title": "Fixed term"
    },
    {
      "id": "start",
      "title": "Start and probation"
    },
    {
      "id": "job",
      "title": "Job"
    },
    {
      "id": "place",
      "title": "Place of work"
    },
    {
      "id": "hours",
      "title": "Hours"
    },
    {
      "id": "pay",
      "title": "Pay and benefits"
    },
    {
      "id": "holiday",
      "title": "Holiday"
    },
    {
      "id": "sickness",
      "title": "Sickness and pension"
    },
    {
      "id": "conduct",
      "title": "Training, discipline and grievances"
    },
    {
      "id": "ending",
      "title": "Notice and restrictions"
    },
    {
      "id": "other",
      "title": "Other terms"
    }
  ],
  "questions": [
    {
      "id": "parties.employer_name",
      "label": "Employer",
      "section": "parties",
      "type": "text",
      "prefill": "company.name",
      "help": "The legal name of the employing company, exactly as registered."
    },
    {
      "id": "parties.employer_address",
      "label": "Employer address",
      "section": "parties",
      "type": "text",
      "prefill": "company.address"
    },
    {
      "id": "parties.employer_number",
      "label": "Company number",
      "section": "parties",
      "type": "text",
      "prefill": "company.number",
      "required": false
    },
    {
      "id": "parties.employee_name",
      "label": "Employee",
      "section": "parties",
      "type": "text",
      "prefill": "officer.name"
    },
    {
      "id": "parties.employee_address",
      "label": "Employee address",
      "section": "parties",
      "type": "text",
      "prefill": "officer.address"
    },
    {
      "id": "term.reason",
      "label": "Reason for the fixed term",
      "section": "term",
      "type": "textarea",
      "help": "Why the job is time-limited, for example \"to cover the security contract for the Riverside Festival\" or \"to cover a colleague's maternity leave\". Printed in the contract."
    },
    {
      "id": "term.end_type",
      "label": "How the fixed term ends",
      "section": "term",
      "type": "choice",
      "schedule": false,
      "options": [
        {
          "value": "date",
          "label": "On a set end date"
        },
        {
          "value": "event",
          "label": "When an event happens or a task is finished"
        }
      ]
    },
    {
      "id": "term.end_date",
      "label": "End date",
      "section": "term",
      "type": "date",
      "showIf": {
        "q": "term.end_type",
        "eq": "date"
      }
    },
    {
      "id": "term.event",
      "label": "End event or task",
      "section": "term",
      "type": "textarea",
      "help": "Describe it so anyone can tell when it has happened, for example \"the return to work of the colleague on maternity leave\" or \"the end of the Company's security contract at Riverside Retail Park\". Avoid vague events such as \"when no longer needed\".",
      "showIf": {
        "q": "term.end_type",
        "eq": "event"
      }
    },
    {
      "id": "term.end_estimate",
      "label": "Expected end date (estimate)",
      "section": "term",
      "type": "date",
      "required": false,
      "help": "Your best reasonable estimate of when the event will happen. It is printed as an estimate, not as the end date.",
      "showIf": {
        "q": "term.end_type",
        "eq": "event"
      }
    },
    {
      "id": "term.early",
      "label": "Ending early",
      "section": "term",
      "type": "choice",
      "help": "Without an early-termination clause, ending the contract early can be a breach of contract.",
      "options": [
        {
          "value": "notice",
          "label": "Either side may end it early by notice",
          "text": "either party may end it early by notice"
        },
        {
          "value": "none",
          "label": "No early ending by notice (except gross misconduct or agreement)",
          "text": "no early ending by notice, except for gross misconduct or by agreement"
        }
      ]
    },
    {
      "id": "term.review_by",
      "label": "End-of-term review and extensions by",
      "section": "term",
      "type": "text",
      "help": "A job title, for example \"Operations Manager\". This person reviews the term with the employee and signs any extension."
    },
    {
      "id": "term.review_notice",
      "label": "Decision on extension given at least",
      "section": "term",
      "type": "text",
      "help": "How long before the end date the employee is told whether the term will be extended, for example \"four weeks\"."
    },
    {
      "id": "term.extension_details",
      "label": "Agreed extension arrangements",
      "section": "term",
      "type": "textarea",
      "required": false,
      "help": "Optional. For example \"the term may be extended if the client extends the event contract\". Leave blank if none."
    },
    {
      "id": "term.previous",
      "label": "Earlier fixed-term contracts with us",
      "section": "term",
      "type": "yesno",
      "schedule": false,
      "help": "Has this person had one or more earlier fixed-term contracts or extensions with the Company (or an associated employer) running up to this one?"
    },
    {
      "id": "term.renewals",
      "label": "Number of earlier fixed-term contracts or extensions",
      "section": "term",
      "type": "number",
      "schedule": false,
      "help": "Count each earlier contract and each extension. 2 or more means this is at least the third in a row.",
      "showIf": {
        "q": "term.previous",
        "eq": "yes"
      }
    },
    {
      "id": "term.first_start",
      "label": "First fixed-term contract began",
      "section": "term",
      "type": "date",
      "showIf": {
        "q": "term.previous",
        "eq": "yes"
      }
    },
    {
      "id": "term.four_years",
      "label": "Four years or more on fixed-term contracts",
      "section": "term",
      "type": "choice",
      "schedule": false,
      "particular": false,
      "help": "By the start of this contract, will the employee have been continuously employed on fixed-term contracts for four years or more?",
      "showIf": {
        "q": "term.previous",
        "eq": "yes"
      },
      "options": [
        {
          "value": "no",
          "label": "No"
        },
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "unsure",
          "label": "Not sure"
        }
      ]
    },
    {
      "id": "term.justification",
      "label": "Objective reason for another fixed term",
      "section": "term",
      "type": "textarea",
      "schedule": false,
      "particular": false,
      "help": "Kept on file, not printed. Why a further fixed term (rather than permanent employment) is genuinely needed.",
      "showIf": {
        "q": "term.four_years",
        "eq": "yes"
      }
    },
    {
      "id": "start.date",
      "label": "Start date",
      "section": "start",
      "type": "date",
      "prefill": "officer.start_date"
    },
    {
      "id": "start.continuous",
      "label": "Continuous employment",
      "section": "start",
      "type": "choice",
      "help": "Earlier employment can count, for example earlier fixed-term contracts with no break, a TUPE transfer or a move from an associated employer.",
      "options": [
        {
          "value": "new",
          "label": "Starts with this job"
        },
        {
          "value": "earlier",
          "label": "Began on an earlier date"
        }
      ],
      "schedule": false
    },
    {
      "id": "start.continuous_date",
      "label": "Continuous employment began",
      "section": "start",
      "type": "date",
      "showIf": {
        "q": "start.continuous",
        "eq": "earlier"
      }
    },
    {
      "id": "probation.used",
      "label": "Probationary period",
      "section": "start",
      "type": "yesno",
      "schedule": false
    },
    {
      "id": "probation.length",
      "label": "Probation length",
      "section": "start",
      "type": "text",
      "help": "For example \"three months\". Probation does not change statutory rights.",
      "showIf": {
        "q": "probation.used",
        "eq": "yes"
      }
    },
    {
      "id": "probation.notice",
      "label": "Notice during probation",
      "section": "start",
      "type": "text",
      "help": "For example \"one week's\". The statutory minimum still applies if it is longer.",
      "showIf": {
        "q": "probation.used",
        "eq": "yes"
      }
    },
    {
      "id": "job.title",
      "label": "Job title",
      "section": "job",
      "type": "text",
      "prefill": "officer.role"
    },
    {
      "id": "job.duties",
      "label": "Main duties",
      "section": "job",
      "type": "textarea",
      "help": "A short description, for example \"access control, patrols and incident reporting at client sites\"."
    },
    {
      "id": "job.reports_to",
      "label": "Reports to",
      "section": "job",
      "type": "text",
      "help": "A job title rather than a name, for example \"the Operations Manager\"."
    },
    {
      "id": "job.licensable",
      "label": "SIA-licensable role",
      "section": "job",
      "type": "yesno",
      "schedule": false
    },
    {
      "id": "job.licence",
      "label": "SIA licence type",
      "section": "job",
      "type": "text",
