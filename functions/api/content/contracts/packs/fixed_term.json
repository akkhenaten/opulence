  "clauses": [
    {
      "id": "parties",
      "title": "Parties",
      "slots": [
        {
          "slot": "parties",
          "clauses": [
            "EMP.PARTIES"
          ]
        }
      ]
    },
    {
      "id": "start",
      "title": "Start of employment",
      "slots": [
        {
          "slot": "start.date",
          "clauses": [
            "EMP.START"
          ]
        },
        {
          "slot": "start.continuous",
          "clauses": [
            "EMP.CONTINUOUS.NEW",
            "EMP.CONTINUOUS.EARLIER"
          ],
          "choose": [
            {
              "when": {
                "q": "start.continuous",
                "eq": "earlier"
              },
              "clause": "EMP.CONTINUOUS.EARLIER"
            }
          ]
        },
        {
          "slot": "start.probation",
          "clauses": [
            "EMP.PROBATION"
          ],
          "include": {
            "q": "probation.used",
            "eq": "yes"
          },
          "why": "Included because there is a probationary period"
        }
      ]
    },
    {
      "id": "fixed_term",
      "title": "Fixed term",
      "slots": [
        {
          "slot": "term.reason",
          "clauses": [
            "FT.REASON"
          ]
        },
        {
          "slot": "term.duration",
          "clauses": [
            "FT.TERM.DATE",
            "FT.TERM.EVENT"
          ],
          "choose": [
            {
              "when": {
                "q": "term.end_type",
                "eq": "event"
              },
              "clause": "FT.TERM.EVENT"
            }
          ]
