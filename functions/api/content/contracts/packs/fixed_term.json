  "rules": [
    {
      "id": "hours-cut-client-site",
      "severity": "blocker",
      "when": {
        "wording": "(reduc|cut|lower|withdraw)\\w*\\s+(your\\s+)?(guaranteed\\s+|contracted\\s+)?(hours|shifts)[^.]{0,160}(client|customer|site|contract (ends|is lost|is not renewed))"
      },
      "message": "The wording lets the Company cut guaranteed hours because a client or site changes. Guaranteed hours can only change with the employee's written agreement. Offer other work, agree a change in writing, or follow a redundancy process instead.",
      "jump": {
        "slot": "hours.change"
      },
      "law": [
        "era2025-fire-and-rehire"
      ]
    },
    {
      "id": "nmw-check",
      "severity": "review",
      "when": {
        "all": [
          {
            "q": "pay.basis",
            "eq": "hourly"
          },
          {
            "q": "pay.rate",
            "lt": 12.71
          }
        ]
      },
      "message": "This rate is below the National Living Wage for workers aged 21 and over (£12.71 from 1 April 2026). Check the employee's age band, and remember that unpaid time and uniform costs count against it.",
      "jump": {
        "question": "pay.rate"
      },
      "law": [
        "nmw-2026"
      ]
    },
    {
      "id": "holiday-below-statutory",
      "severity": "review",
      "when": {
        "all": [
          {
            "q": "holiday.basis",
            "eq": "enhanced"
          },
          {
            "q": "holiday.days",
            "lt": 28
          }
        ]
      },
      "message": "Fewer than 28 days is only lawful if the employee works fewer than five days a week, because 5.6 weeks is the statutory minimum. Check the number for this working pattern.",
      "jump": {
        "question": "holiday.days"
      }
    },
    {
      "id": "hours-over-48",
      "severity": "review",
      "when": {
        "q": "hours.weekly",
        "gt": 48
      },
      "message": "These hours are above the 48-hour average. That needs a separate, voluntary opt-out signed by the employee. It must not be a condition of the job.",
      "jump": {
        "question": "hours.weekly"
      },
      "law": [
        "wtr-security-special-case"
      ]
    },
    {
      "id": "restriction-review",
      "severity": "review",
      "when": {
        "q": "restrict.used",
        "eq": "yes"
      },
      "message": "Restrictions after employment are only enforceable if they protect a real business interest and go no further than needed. Keep the period short and the scope to clients the employee actually dealt with.",
      "jump": {
        "question": "restrict.period"
      }
    },
    {
      "id": "ni-written-statement-timing",
      "severity": "note",
      "when": {
        "jurisdiction": "ni"
      },
      "message": "In Northern Ireland the written statement is due within two months of the start date. Sending it before the first day is still the best practice.",
      "law": [
        "ni-written-statement"
      ]
    },
    {
      "id": "ft-third-contract",
      "severity": "review",
      "when": {
        "all": [
          {
            "q": "term.previous",
            "eq": "yes"
          },
          {
            "q": "term.renewals",
            "gte": 2
          }
        ]
      },
      "message": "This is at least the third fixed-term contract or extension in a row. Check that a fixed term is still genuinely needed and record why, add up the employee's total continuous service for the four-year rule, and consider offering a permanent contract instead. Repeated renewals can also make each non-renewal harder to justify as fair.",
      "jump": {
        "question": "term.renewals"
      },
      "law": [
        "fte-regs-2002",
        "fte-regs-ni-2002"
      ]
    },
    {
      "id": "ft-four-years",
      "severity": "review",
      "when": {
        "all": [
          {
            "q": "term.previous",
            "eq": "yes"
          },
          {
            "q": "term.four_years",
            "eq": "yes"
          }
        ]
      },
      "message": "With four years or more on successive fixed-term contracts, a renewal normally makes the employee permanent by law unless another fixed term is objectively justified (or a collective or workforce agreement changes the rule). Use the permanent pack, or record the objective reason and have it checked before issuing another fixed term.",
      "jump": {
        "question": "term.justification"
      },
      "law": [
        "fte-regs-2002",
        "fte-regs-ni-2002"
      ]
    },
    {
      "id": "ft-four-years-unsure",
      "severity": "review",
      "when": {
        "all": [
          {
            "q": "term.previous",
            "eq": "yes"
          },
          {
            "q": "term.four_years",
            "eq": "unsure"
          }
        ]
      },
      "message": "Work out the employee's continuous service on fixed-term contracts before sending. Short gaps do not always break continuity. If it is four years or more, the employee is likely already permanent unless another fixed term is objectively justified.",
      "jump": {
        "question": "term.four_years"
      },
      "law": [
        "fte-regs-2002",
        "fte-regs-ni-2002"
      ]
    },
    {
      "id": "ft-event-no-estimate",
      "severity": "review",
      "when": {
        "all": [
          {
            "q": "term.end_type",
            "eq": "event"
          },
          {
            "q": "term.end_estimate",
            "empty": true
          }
        ]
      },
      "message": "The fixed term ends on an event with no expected date. Check that the event is objectively identifiable (anyone could tell when it has happened) and add a reasonable estimate of when it will happen, so the employee can plan and the end-of-term review starts on time. If the end cannot be identified, consider the permanent pack.",
      "jump": {
        "question": "term.end_estimate"
      },
      "law": [
        "fte-regs-2002",
        "fte-regs-ni-2002"
      ]
    },
    {
      "id": "ft-earlier-service",
      "severity": "review",
      "when": {
        "all": [
          {
            "q": "term.previous",
            "eq": "yes"
          },
          {
            "q": "start.continuous",
            "eq": "new"
          }
        ]
      },
      "message": "This follows earlier fixed-term contracts, but continuous employment is set to start with this job. Earlier contracts with no break that ends continuity usually count. Check the date and choose \"Began on an earlier date\" if they do.",
      "jump": {
        "question": "start.continuous"
      },
      "law": [
        "fte-regs-2002",
        "fte-regs-ni-2002"
      ]
    },
    {
      "id": "ft-no-early-termination",
      "severity": "note",
      "when": {
        "q": "term.early",
        "eq": "none"
      },
      "message": "Without an early-termination clause, ending the contract early (other than for gross misconduct, during probation or by agreement) is likely to be a breach of contract, and the employee may claim pay for the rest of the term. Choose \"Either side may end it early by notice\" if the work could stop before the end.",
      "jump": {
        "question": "term.early"
      },
      "law": [
        "fixed-term-expiry-dismissal",
        "fixed-term-expiry-dismissal-ni"
      ]
    },
    {
      "id": "ft-expiry-is-dismissal",
      "severity": "note",
      "when": {
        "q": "term.end_type"
      },
      "message": "When the term ends without renewal, the law treats it as a dismissal for unfair dismissal and redundancy purposes. Before the end date, meet the employee, explain the reason, consider other suitable work, and offer a right of appeal. A redundancy payment may be due depending on the reason and length of service. Do not ask the employee to waive these rights.",
      "jump": {
        "slot": "term.expiry"
      },
      "law": [
        "fixed-term-expiry-dismissal",
        "fixed-term-expiry-dismissal-ni"
      ]
    },
    {
      "id": "ft-expiry-removes-rights",
      "severity": "blocker",
      "when": {
        "any": [
          {
            "wording": "(waive|waiver|give up|forgo|exclud\\w*|remov\\w*|lose|forfeit)\\w*[^.]{0,80}(right\\w*[^.]{0,30}(redundancy|unfair dismissal|notice|claim)|redundancy pay\\w*|unfair dismissal)"
          },
          {
            "wording": "(expir\\w*|end\\w*|non-renewal)[^.]{0,80}(is not|will not be|shall not (be|constitute)|does not (count as|amount to|constitute))( a)? dismissal"
          },
          {
            "wording": "(automatic\\w*|simply)[^.]{0,60}(end|expire|terminate)\\w*[^.]{0,80}(no|without( any)?) (notice|redundancy|dismissal|claim|rights)"
          }
        ]
      },
      "message": "The wording says or suggests that the end of the fixed term removes statutory rights, is not a dismissal, or rules out notice or redundancy. That is wrong in law and waivers of these rights are void. Remove it and use the standard end-of-term clause.",
      "jump": {
        "slot": "term.expiry"
      },
      "law": [
        "fixed-term-expiry-dismissal",
        "fixed-term-expiry-dismissal-ni"
      ]
    }
  ],
