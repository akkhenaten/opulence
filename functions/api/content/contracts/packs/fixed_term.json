      "help": "Period, currency of pay, extra pay or benefits, and terms on return.",
      "showIf": {
        "q": "place.abroad",
        "eq": "yes"
      }
    },
    {
      "id": "hours.pattern",
      "label": "Working pattern",
      "section": "hours",
      "type": "choice",
