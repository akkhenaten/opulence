{
  "id": "subcontract",
  "version": 1,
  "title": "Security subcontract agreement",
  "summary": "Another security business takes responsibility for delivering a defined service, managing and supervising its own people.",
  "party": "organisation",
  "engagement_type": "subcontractor",
  "doc_title": "Security Services Subcontract",
  "jurisdictions": [
    "ew",
    "sc",
    "ni"
  ],
  "law": [
    "sia-labour-or-subcontract",
    "sia-acs-subcontracting",
    "sia-acs-workbook-2026",
    "tupe-2006",
    "ni-spc-2006"
  ],
  "decision": {
    "hint": "The other security business takes responsibility for delivering a defined service and manages and supervises its own people: if your supervisors will direct them, use the labour-provider agreement instead."
  },
  "sections": [
    {
      "id": "parties",
      "title": "Parties and term"
    },
    {
      "id": "services",
      "title": "Services and sites"
    },
    {
      "id": "management",
      "title": "Management"
    },
    {
      "id": "compliance",
      "title": "Accreditation and subcontracting"
    },
    {
      "id": "performance",
      "title": "Performance and continuity"
    },
    {
      "id": "rates",
      "title": "Charges and invoicing"
    },
    {
      "id": "insurance",
      "title": "Insurance and liability"
    },
    {
      "id": "ending",
      "title": "Ending and disputes"
    }
  ],
  "questions": [
    {
      "id": "parties.company_name",
      "label": "The Company",
      "section": "parties",
      "type": "text",
      "prefill": "company.name",
      "help": "Your company's legal name, exactly as registered."
    },
    {
      "id": "parties.company_address",
      "label": "Company address",
      "section": "parties",
      "type": "text",
      "prefill": "company.address",
      "help": "Registered office or main business address."
    },
    {
      "id": "parties.company_number",
      "label": "Company number",
      "section": "parties",
      "type": "text",
      "prefill": "company.number",
      "required": false
    },
    {
      "id": "parties.supplier_name",
      "label": "The Supplier",
      "section": "parties",
      "type": "text",
      "prefill": "organisation.name",
      "help": "The other business's legal name, exactly as registered (or the sole trader's full name and trading name)."
    },
    {
      "id": "parties.supplier_address",
      "label": "Supplier address",
      "section": "parties",
      "type": "text",
      "prefill": "organisation.address"
    },
    {
      "id": "parties.supplier_number",
      "label": "Supplier company number",
      "section": "parties",
      "type": "text",
      "prefill": "organisation.number",
      "required": false,
      "help": "Leave blank for a sole trader or partnership."
    },
    {
      "id": "parties.supplier_signatory",
      "label": "Signing for the Supplier",
      "section": "parties",
      "type": "text",
      "prefill": "organisation.signatory"
    },
    {
      "id": "parties.supplier_signatory_title",
      "label": "Signatory's position",
      "section": "parties",
      "type": "text",
      "prefill": "organisation.signatory_title",
      "help": "For example \"Director\"."
    },
    {
      "id": "agreement.start",
      "label": "Agreement starts",
      "section": "parties",
      "type": "date",
      "prefill": "effective_date"
    },
    {
      "id": "agreement.term",
      "label": "Length of the agreement",
      "section": "parties",
      "type": "choice",
      "schedule": false,
      "options": [
        {
          "value": "rolling",
          "label": "Continues until either party gives notice"
        },
        {
          "value": "fixed",
          "label": "Ends on a fixed date"
        }
      ]
    },
    {
      "id": "agreement.end",
      "label": "Agreement ends",
      "section": "parties",
      "type": "date",
      "showIf": {
        "q": "agreement.term",
        "eq": "fixed"
      }
    },
    {
      "id": "services.description",
      "label": "Services",
      "section": "services",
      "type": "textarea",
      "help": "What the Supplier delivers, for example \"static guarding, access control and mobile patrols\". Attach a full specification if you have one."
    },
    {
      "id": "services.exclusions",
      "label": "Exclusions",
      "section": "services",
      "type": "textarea",
      "help": "What is not included, for example \"key holding and alarm response\", or \"none\"."
    },
    {
      "id": "services.sites",
      "label": "Sites",
      "section": "services",
      "type": "textarea"
    },
    {
      "id": "services.hours",
      "label": "Operating hours",
      "section": "services",
      "type": "textarea",
      "help": "For example \"24 hours a day, every day\" or the hours for each site."
    },
    {
      "id": "services.coverage",
      "label": "Required coverage",
      "section": "services",
      "type": "textarea",
      "help": "Positions and numbers, for example \"one officer at reception and one patrolling officer during operating hours\"."
    },
    {
      "id": "services.mobilisation_date",
      "label": "Mobilisation date",
      "section": "services",
      "type": "date",
      "help": "The date the Supplier must be ready to deliver the Services in full."
    },
    {
      "id": "management.supervision_by",
      "label": "Who directs and supervises the Supplier's people on shift?",
      "section": "management",
      "type": "choice",
      "schedule": false,
      "particular": false,
      "help": "In a subcontract the Supplier manages and supervises its own people.",
      "options": [
        {
          "value": "supplier",
          "label": "The Supplier's own supervisors"
        },
        {
          "value": "company",
          "label": "Our supervisors, as part of our team"
        }
      ]
    },
    {
      "id": "management.supervision",
      "label": "Supplier's supervision arrangements",
      "section": "management",
      "type": "textarea",
      "help": "For example \"a mobile supervisor visits each site at least once each shift and a duty manager is on call\"."
    },
    {
      "id": "management.supplier_contact",
      "label": "Supplier's contract manager",
      "section": "management",
      "type": "text"
    },
    {
      "id": "management.company_contact",
      "label": "Company's contact",
      "section": "management",
      "type": "text",
      "help": "A job title, for example \"the Contracts Manager\"."
    },
    {
      "id": "management.review_frequency",
      "label": "Service reviews",
      "section": "management",
      "type": "text",
      "help": "For example \"monthly\"."
    },
    {
      "id": "acs.company",
      "label": "Is your company an SIA approved contractor?",
      "section": "compliance",
      "type": "yesno",
      "schedule": false,
      "particular": false
    },
    {
      "id": "acs.supplier",
      "label": "Is the Supplier an SIA approved contractor for these services?",
      "section": "compliance",
      "type": "yesno",
      "schedule": false,
      "particular": false,
      "showIf": {
        "q": "acs.company",
        "eq": "yes"
      }
    },
    {
      "id": "acs.permission",
      "label": "Has the SIA agreed in writing to this subcontract?",
      "section": "compliance",
      "type": "yesno",
      "schedule": false,
      "particular": false,
      "showIf": {
        "all": [
          {
            "q": "acs.company",
            "eq": "yes"
          },
          {
            "q": "acs.supplier",
            "eq": "no"
          }
        ]
      }
    },
    {
      "id": "further.allowed",
      "label": "Can the Supplier subcontract further?",
      "section": "compliance",
      "type": "choice",
      "schedule": false,
      "options": [
        {
          "value": "none",
          "label": "No"
        },
        {
          "value": "approved",
          "label": "Only with our written approval"
        }
      ]
    },
    {
      "id": "performance.measures",
      "label": "Performance measures",
      "section": "performance",
      "type": "textarea",
      "help": "For example \"all shifts filled; patrols completed and logged; incident reports submitted before the end of the shift\"."
    },
    {
      "id": "performance.reporting_frequency",
      "label": "Performance reports",
      "section": "performance",
      "type": "text",
      "help": "For example \"monthly\"."
    },
    {
      "id": "performance.correction_period",
      "label": "Time to provide a corrective plan",
      "section": "performance",
      "type": "text",
      "help": "For example \"five working days\"."
    },
    {
      "id": "continuity.notice",
      "label": "Notice of a coverage gap",
      "section": "performance",
      "type": "text",
      "help": "For example \"one hour\"."
    },
    {
      "id": "charges.schedule",
      "label": "Charges",
      "section": "rates",
      "type": "textarea",
      "help": "The price of the Services, for example hourly charges per position or a monthly fee per site. Do not enter the operatives' wages here."
    },
    {
      "id": "charges.lowest_hourly",
      "label": "Lowest hourly charge (if charged by the hour)",
      "section": "rates",
      "type": "money",
      "required": false,
      "schedule": false,
      "particular": false,
      "help": "Used only to check the charges look realistic."
    },
    {
      "id": "invoice.frequency",
      "label": "Invoices sent",
      "section": "rates",
      "type": "choice",
      "options": [
        {
          "value": "weekly",
          "label": "Weekly",
          "text": "weekly in arrears"
        },
        {
          "value": "fortnightly",
          "label": "Every two weeks",
          "text": "every two weeks in arrears"
        },
        {
          "value": "monthly",
          "label": "Monthly",
          "text": "monthly in arrears"
        }
      ]
    },
    {
      "id": "invoice.payment_terms",
      "label": "Payment terms",
      "section": "rates",
      "type": "text",
      "help": "For example \"30 days of receipt of a valid invoice\". Agree this; it is not set for you."
    },
    {
      "id": "invoice.dispute_period",
      "label": "Time to dispute an invoice",
      "section": "rates",
      "type": "text",
      "help": "For example \"10 working days\"."
    },
    {
      "id": "insurance.employers_liability",
      "label": "Employers' liability cover (each occurrence)",
      "section": "insurance",
      "type": "money",
      "help": "The minimum the Supplier must hold. It must be at least the statutory minimum; many clients ask for more."
    },
    {
      "id": "insurance.public_liability",
      "label": "Public liability cover (each occurrence)",
      "section": "insurance",
      "type": "money",
      "help": "Check what your own client contracts require and ask for at least that."
    },
    {
      "id": "insurance.other_required",
      "label": "Other insurance required",
      "section": "insurance",
      "type": "yesno",
      "schedule": false,
      "help": "For example professional indemnity, or cover a particular client requires."
    },
    {
      "id": "insurance.other",
      "label": "Other insurance",
      "section": "insurance",
      "type": "textarea",
      "showIf": {
        "q": "insurance.other_required",
        "eq": "yes"
      },
      "help": "Type and minimum amount of each policy, for example \"professional indemnity insurance of not less than £1,000,000 for each claim\"."
    },
    {
      "id": "liability.cap",
      "label": "Limit on each party's liability",
      "section": "insurance",
      "type": "text",
      "help": "For example \"the total charges paid or payable under this agreement in that contract year\". Take advice before agreeing a cap."
    },
    {
      "id": "nonsolicit.used",
      "label": "Non-solicitation of staff",
      "section": "ending",
      "type": "yesno",
      "schedule": false,
      "help": "Mutual promise not to poach each other's employees."
    },
    {
      "id": "nonsolicit.period",
      "label": "Non-solicitation period",
      "section": "ending",
      "type": "text",
      "showIf": {
        "q": "nonsolicit.used",
        "eq": "yes"
      },
      "help": "Keep it short, for example \"six months\"."
    },
    {
      "id": "exit.assistance_period",
      "label": "Handover period before the end date",
      "section": "ending",
      "type": "text",
      "help": "For example \"four weeks\"."
    },
    {
      "id": "termination.notice",
      "label": "Notice to end the agreement",
      "section": "ending",
      "type": "text",
      "help": "For example \"one month's\"."
    },
    {
      "id": "termination.remedy_period",
      "label": "Time to put a breach right",
      "section": "ending",
      "type": "text",
      "help": "For example \"14 days\"."
    },
    {
      "id": "disputes.escalation_period",
      "label": "Time for contacts to resolve a dispute",
      "section": "ending",
      "type": "text",
      "help": "For example \"10 working days\"."
    },
    {
      "id": "tupe.assessment",
      "label": "Could TUPE apply?",
      "section": "ending",
      "type": "choice",
      "schedule": false,
      "particular": false,
      "help": "A change of contractor for a security service is a classic service provision change. If this subcontract takes over work your own staff, or another contractor's staff, were doing, TUPE may apply now and again when it ends.",
      "options": [
        {
          "value": "assessed_no",
          "label": "Assessed: no transfer expected"
        },
        {
          "value": "may_apply",
          "label": "It may apply"
        },
        {
          "value": "unsure",
          "label": "Not yet assessed"
        }
      ]
    }
  ],
