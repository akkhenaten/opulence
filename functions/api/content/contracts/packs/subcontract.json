  "rules": [
    {
      "id": "looks-like-labour-supply",
      "severity": "review",
      "when": {
        "q": "management.supervision_by",
        "eq": "company"
      },
      "message": "If your supervisors will direct and supervise the Supplier's people as part of your team, this is labour supply, not a subcontract. Use the labour-provider agreement instead: you then become responsible for checking their screening and vetting, and the ACS subcontracting rule does not apply.",
      "jump": {
        "question": "management.supervision_by"
      },
      "law": [
        "sia-labour-or-subcontract"
      ]
    },
    {
      "id": "acs-subcontract-not-approved",
      "severity": "blocker",
      "when": {
        "all": [
          {
            "q": "acs.company",
            "eq": "yes"
          },
          {
            "q": "acs.supplier",
            "eq": "no"
          },
          {
            "q": "acs.permission",
            "ne": "yes"
          }
        ]
      },
      "message": "As an SIA approved contractor you may only subcontract designated security services to another approved contractor, unless the SIA has agreed otherwise. Use an approved contractor, obtain and record the SIA's written agreement, or, if your supervisors will direct these people, use the labour-provider agreement instead.",
      "jump": {
        "question": "acs.supplier"
      },
      "law": [
        "sia-acs-subcontracting",
        "sia-acs-workbook-2026"
      ]
    },
    {
      "id": "acs-permission-record",
      "severity": "review",
      "when": {
        "all": [
          {
            "q": "acs.company",
            "eq": "yes"
          },
          {
            "q": "acs.supplier",
            "eq": "no"
          },
          {
            "q": "acs.permission",
            "eq": "yes"
          }
        ]
      },
      "message": "Keep a copy of the SIA's written agreement with this contract and check any conditions it sets are reflected in the assignment instructions and performance measures.",
      "jump": {
        "slot": "acs"
      },
      "law": [
        "sia-acs-subcontracting"
      ]
    },
    {
      "id": "acs-onward",
      "severity": "note",
      "when": {
        "all": [
          {
            "q": "acs.company",
            "eq": "yes"
          },
          {
            "q": "further.allowed",
            "eq": "approved"
          }
        ]
      },
      "message": "Under the Approved Contractor Scheme, an approved subcontractor may not pass work on to a business that is not approved without the SIA's approval and your client's agreement. Check this before approving any further subcontractor.",
      "jump": {
        "slot": "further"
      },
      "law": [
        "sia-acs-workbook-2026"
      ]
    },
    {
      "id": "subcontract-screening",
      "severity": "note",
      "when": {
