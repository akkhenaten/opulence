{
  "id": "self_employed",
  "version": 1,
  "title": "Self-employed individual (services)",
  "summary": "A genuinely independent individual supplying services as their own business, after a status assessment.",
  "party": "person",
  "engagement_type": "self_employed",
  "doc_title": "Services Agreement",
  "jurisdictions": [
    "ew",
    "sc",
    "ni"
  ],
  "law": [
    "sia-hmrc-security-operatives",
    "itepa-agency-rules",
    "employment-status-services"
  ],
  "decision": {
    "hint": "An individual runs their own business: they decide how the work is done, can genuinely send someone else or carry real financial risk, and work for other customers."
  },
