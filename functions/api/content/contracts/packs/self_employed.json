    }
  ],
  "assessment": {
    "title": "Status assessment",
    "intro": "Answer from what really happens on site, not from what the agreement says. Employment rights and tax are decided separately: someone can be self-employed for employment rights but still taxed through PAYE, for example under the agency rules.",
    "questions": [
      {
        "id": "personal_service",
        "label": "In practice, who does the work?",
        "help": "Describe what really happens, not what a contract says. Clothing, a phone, a torch or travel to work do not make the Supplier a business.",
        "options": [
          {
            "value": "personal",
            "label": "The Supplier personally, every time"
          },
          {
            "value": "business",
            "label": "A business that decides who does the work and has its own staff or associates"
          },
          {
            "value": "unclear",
            "label": "Not clear yet"
          }
        ]
      },
      {
        "id": "substitution",
        "label": "If the Supplier cannot attend, can the Supplier genuinely send someone else?",
        "help": "A substitution right only counts if the Supplier really chooses, engages and pays the replacement, and the Company has no veto beyond checking the replacement is licensed, screened and competent. If the Company always finds the cover, or approves people at its discretion, the answer is not \"real\".",
        "options": [
          {
            "value": "real",
            "label": "Yes: the Supplier chooses, engages and pays the replacement; the Company only checks licence, screening and competence"
          },
          {
            "value": "limited",
            "label": "Only someone the Company approves at its discretion"
          },
          {
            "value": "no",
            "label": "No: the Company finds the cover, or the work is simply not done"
          },
          {
            "value": "unclear",
            "label": "Not clear yet"
          }
        ]
      },
      {
        "id": "control",
        "label": "Who has the right to decide how, when and where the work is done?",
        "help": "Count the right to control even if it is rarely used. Supervision, direction or control includes rotas, patrol routes, reporting routines and mandatory site procedures, even where those procedures come from regulation (HMRC ESM2037).",
        "options": [
          {
            "value": "directed",
            "label": "The Company or the client: they set times, tasks, routes or procedures and can tell the person how to work"
          },
          {
            "value": "own_method",
            "label": "The Supplier: only the result and the legal or site requirements are set"
          },
          {
            "value": "unclear",
            "label": "Not clear yet"
          }
        ]
      },
      {
        "id": "financial_risk",
        "label": "Does the Supplier carry real financial risk?",
        "help": "For example: putting poor work right at its own cost, fixed prices that can make a loss, significant investment, or its own staff to pay. Paying for a uniform, phone, torch or travel to work is not financial risk.",
        "options": [
          {
            "value": "yes",
            "label": "Yes, real business risk"
          },
          {
            "value": "no",
            "label": "No: paid for time, with no real risk of loss"
          },
          {
            "value": "unclear",
            "label": "Not clear yet"
          }
        ]
      },
      {
        "id": "equipment",
        "label": "Who provides the equipment needed for the work?",
        "options": [
          {
            "value": "supplier",
            "label": "The Supplier provides its own significant equipment"
          },
          {
            "value": "mixed",
            "label": "Shared: the Supplier provides some significant items, the Company or client the rest"
          },
          {
            "value": "company",
            "label": "The Company or the client provides it (beyond basic clothing and a phone)"
          }
        ]
      },
      {
        "id": "other_clients",
        "label": "Does the Supplier actually work for other customers?",
        "help": "Actual work for others in business, not just being free to.",
        "options": [
          {
            "value": "yes",
            "label": "Yes, in practice"
          },
          {
            "value": "no",
            "label": "No, or only in theory"
          }
        ]
      },
      {
        "id": "mutual_obligation",
        "label": "What happens in practice about offering and accepting work?",
        "help": "Look at the pattern, not the wording. A regular rota that is expected to be filled is an ongoing obligation even if each shift is \"offered\".",
        "options": [
          {
            "value": "none",
            "label": "Each piece of work is genuinely offered and can be turned down without consequence"
          },
          {
            "value": "ongoing",
            "label": "There is a regular pattern, or work is expected to be offered and accepted"
          },
          {
            "value": "unclear",
            "label": "Not clear yet"
          }
        ]
      },
      {
        "id": "integration",
        "label": "Is the Supplier part of the Company's organisation?",
        "help": "For example: wears the Company uniform as if staff, is on the Company rota, manages staff, or is treated like an employee.",
        "options": [
          {
            "value": "no",
            "label": "No, clearly an outside business"
          },
          {
            "value": "yes",
            "label": "Yes, treated much like staff"
          }
        ]
      },
      {
        "id": "deployment",
        "label": "Where is the work done?",
        "help": "This decides whether the tax agency rules (ITEPA 2003 section 44) or the off-payroll working rules need checking.",
        "options": [
          {
            "value": "client_sites",
            "label": "Deployed to client sites under the Company's contracts with its clients"
          },
          {
            "value": "company",
            "label": "Works only for the Company itself (for example the Company's own premises or projects)"
          }
        ]
      }
    ],
    "outcomes": {
      "employment": [
        {
          "result": "unresolved",
          "when": {
            "any": [
              {
                "assessment": "personal_service",
                "eq": "unclear"
              },
              {
                "assessment": "substitution",
                "eq": "unclear"
              },
              {
                "assessment": "control",
                "eq": "unclear"
              },
              {
                "assessment": "financial_risk",
                "eq": "unclear"
              },
              {
                "assessment": "mutual_obligation",
                "eq": "unclear"
              }
            ]
          }
        },
        {
          "result": "employee",
          "when": {
            "all": [
              {
                "any": [
                  {
                    "assessment": "substitution",
                    "eq": "no"
                  },
                  {
                    "assessment": "substitution",
                    "eq": "limited"
                  }
                ]
              },
              {
                "assessment": "control",
                "eq": "directed"
              },
              {
                "assessment": "mutual_obligation",
                "eq": "ongoing"
              },
              {
                "assessment": "integration",
                "eq": "yes"
              }
            ]
          }
        },
        {
          "result": "worker",
          "when": {
            "all": [
              {
                "any": [
                  {
                    "assessment": "substitution",
                    "eq": "no"
                  },
                  {
                    "assessment": "substitution",
                    "eq": "limited"
                  }
                ]
              },
              {
                "any": [
                  {
                    "assessment": "control",
                    "eq": "directed"
                  },
                  {
                    "assessment": "financial_risk",
                    "eq": "no"
                  },
                  {
                    "assessment": "integration",
                    "eq": "yes"
                  }
                ]
              }
            ]
          }
        },
        {
          "result": "self_employed",
          "when": {
            "any": [
              {
                "all": [
                  {
                    "assessment": "substitution",
                    "eq": "real"
                  },
                  {
                    "assessment": "personal_service",
                    "eq": "business"
                  }
                ]
              },
              {
                "all": [
                  {
                    "assessment": "control",
                    "eq": "own_method"
                  },
                  {
                    "assessment": "financial_risk",
                    "eq": "yes"
                  },
                  {
                    "assessment": "other_clients",
                    "eq": "yes"
                  },
                  {
                    "assessment": "integration",
                    "eq": "no"
                  }
                ]
              }
            ]
          }
        }
      ],
      "tax": [
        {
          "result": "unresolved",
          "when": {
            "any": [
              {
                "assessment": "personal_service",
                "eq": "unclear"
              },
              {
                "assessment": "substitution",
                "eq": "unclear"
              },
              {
                "assessment": "control",
                "eq": "unclear"
              },
              {
                "assessment": "financial_risk",
                "eq": "unclear"
              },
              {
                "assessment": "mutual_obligation",
                "eq": "unclear"
              }
            ]
          }
        },
        {
          "result": "employed",
          "when": {
            "all": [
              {
                "assessment": "control",
                "eq": "directed"
              },
              {
                "assessment": "deployment",
                "eq": "client_sites"
              }
            ]
          }
        },
        {
          "result": "employed",
          "when": {
            "all": [
              {
                "assessment": "control",
                "eq": "directed"
              },
              {
                "any": [
                  {
                    "assessment": "financial_risk",
                    "eq": "no"
                  },
                  {
                    "assessment": "mutual_obligation",
                    "eq": "ongoing"
                  },
                  {
                    "assessment": "integration",
                    "eq": "yes"
                  }
                ]
              }
            ]
          }
        },
        {
          "result": "self_employed",
          "when": {
            "all": [
              {
                "assessment": "control",
                "eq": "own_method"
              },
              {
                "assessment": "financial_risk",
                "eq": "yes"
              },
              {
                "any": [
                  {
                    "assessment": "substitution",
                    "eq": "real"
                  },
                  {
                    "assessment": "other_clients",
                    "eq": "yes"
                  }
                ]
              },
              {
                "any": [
                  {
                    "assessment": "equipment",
                    "eq": "supplier"
                  },
                  {
                    "assessment": "equipment",
                    "eq": "mixed"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "expects": {
      "employment": [
        "self_employed"
      ],
      "tax": [
        "self_employed",
        "employed"
      ]
    },
    "mismatch": "If the Supplier is a worker or employee for employment rights, use the casual worker, fixed-term or permanent pack instead. Do not adjust the answers or wording to fit this pack."
  },
