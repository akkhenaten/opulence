  "rules": [
    {
      "id": "sham-substitution",
      "severity": "blocker",
      "when": {
        "all": [
          {
            "not": {
              "assessment": "substitution",
              "eq": "real"
            }
          },
          {
            "any": [
              {
                "clause": "SE.PERSONNEL.SUBSTITUTION"
              },
              {
                "wording": "(right|free|entitled|may|can)\\b[^.]{0,80}\\b(send|provide|use|appoint)\\w*\\b[^.]{0,40}\\bsubstitut"
              }
            ]
          }
        ]
      },
      "message": "The wording gives the Supplier a right to send a substitute, but the status assessment does not record a real, workable substitution arrangement. Do not add a substitution right to make the engagement look independent. Use the wording that matches what happens (personal service, or replacements only with approval), or correct the assessment if a real right exists in practice.",
      "jump": {
        "slot": "personnel"
      },
      "law": [
        "sia-hmrc-security-operatives",
        "employment-status-services"
      ]
    },
    {
      "id": "sham-independence",
      "severity": "blocker",
      "when": {
        "all": [
          {
            "not": {
              "all": [
                {
                  "assessment": "control",
                  "eq": "own_method"
                },
                {
                  "assessment": "financial_risk",
                  "eq": "yes"
                },
                {
                  "assessment": "other_clients",
                  "eq": "yes"
                },
                {
                  "assessment": "integration",
                  "eq": "no"
                }
              ]
            }
          },
          {
            "any": [
              {
                "clause": "SE.STATUS.INDEPENDENT"
              },
              {
                "wording": "independent business|on (its|his|her|their) own account|in business on (its|his|her|their) own"
              }
            ]
          }
        ]
      },
      "message": "The wording describes the Supplier as an independent business, but the assessment does not show it: the Supplier must decide how the work is done, carry real financial risk, actually work for other customers and not be part of the Company. Use the neutral status clause instead, or correct the assessment if it is wrong.",
      "jump": {
        "slot": "status"
      },
      "law": [
        "sia-hmrc-security-operatives",
        "employment-status-services"
      ]
    },
    {
      "id": "sham-own-method",
      "severity": "blocker",
      "when": {
        "all": [
          {
            "clause": "SVC.DELIVERY.OWN_METHOD"
          },
          {
            "not": {
              "assessment": "control",
              "eq": "own_method"
            }
          }
        ]
      },
      "message": "The wording says the Supplier decides how the work is done, but the assessment records that the Company or the client has that control. Use the \"Company requirements\" delivery wording, which reflects the real arrangement.",
      "jump": {
        "slot": "delivery.method"
      },
      "law": [
        "itepa-agency-rules",
        "sia-hmrc-security-operatives"
      ]
    },
    {
      "id": "assignments-vs-practice",
      "severity": "blocker",
      "when": {
        "all": [
          {
            "q": "assignments.model",
            "eq": "offered"
          },
          {
            "assessment": "mutual_obligation",
            "eq": "ongoing"
          }
        ]
      },
      "message": "The wording says each Assignment can be declined with no promise of work, but the assessment records a regular pattern or an expectation to offer and accept work. Record the real programme and commitments, or use the worker or employee route if that is what the arrangement is.",
      "jump": {
        "question": "assignments.model"
      },
      "law": [
        "employment-status-services"
      ]
    },
    {
      "id": "assessment-unclear",
      "severity": "review",
      "when": {
        "any": [
          {
            "assessment": "personal_service",
            "eq": "unclear"
          },
          {
            "assessment": "substitution",
            "eq": "unclear"
          },
          {
            "assessment": "control",
            "eq": "unclear"
          },
          {
            "assessment": "financial_risk",
            "eq": "unclear"
          },
          {
            "assessment": "mutual_obligation",
            "eq": "unclear"
          }
        ]
      },
      "message": "Part of the status assessment is \"not clear yet\", so this route needs review. Find out what actually happens on site before relying on this agreement, and take advice if it stays unclear.",
      "jump": {
        "assessment": true
      },
      "law": [
        "employment-status-services"
      ]
    },
    {
      "id": "assessment-unresolved",
      "severity": "review",
      "when": {
        "any": [
          {
            "outcome": "employment",
            "eq": "unresolved"
          },
          {
            "outcome": "tax",
            "eq": "unresolved"
          }
        ]
      },
      "message": "The status outcome is recorded as unresolved, so this route requires review. Do not send the agreement until the employment and tax status have been decided, with advice if needed.",
      "jump": {
        "assessment": true
      },
      "law": [
        "employment-status-services"
      ]
    },
    {
      "id": "agency-rules",
      "severity": "review",
      "when": {
        "all": [
          {
            "assessment": "control",
            "eq": "directed"
          },
          {
            "assessment": "deployment",
            "eq": "client_sites"
          }
        ]
      },
      "message": "The Supplier is deployed to the Company's clients and someone has the right to supervise, direct or control the work. Under the agency rules (ITEPA 2003 section 44) the Company must then operate PAYE, whatever the agreement says about substitution. Check whether the Supplier is in fact a worker or employee for employment rights.",
      "jump": {
        "assessment": true
      },
      "law": [
        "itepa-agency-rules",
        "sia-hmrc-security-operatives"
      ]
    },
    {
      "id": "gross-but-employed",
      "severity": "blocker",
      "when": {
        "all": [
          {
            "clause": "SE.TAX.GROSS"
          },
          {
            "any": [
              {
                "outcome": "tax",
                "eq": "employed"
              },
              {
                "all": [
                  {
                    "assessment": "control",
                    "eq": "directed"
                  },
                  {
                    "assessment": "deployment",
                    "eq": "client_sites"
                  }
                ]
              }
            ]
          }
        ]
      },
      "message": "This draft pays the fees without deductions, but the assessment shows the Supplier must be treated as employed for tax (for example under the agency rules). Use the PAYE tax clause instead.",
      "jump": {
        "slot": "tax.treatment"
      },
      "law": [
        "itepa-agency-rules",
        "sia-hmrc-security-operatives"
      ]
    },
    {
      "id": "acs-deployment",
      "severity": "review",
      "when": {
        "all": [
          {
            "q": "company.acs",
            "eq": "yes"
          },
          {
            "clause": "SE.TAX.GROSS"
          }
        ]
      },
      "message": "The Company is an SIA approved contractor, and this draft pays the Supplier without PAYE. The ACS requires everyone the Company deploys to be an employee or treated as an employee for tax. Pay through PAYE (or engage the person as staff), or confirm that this Supplier is not deployed under the scheme.",
      "jump": {
        "question": "company.acs"
      },
      "law": [
        "sia-acs-workbook-2026",
        "sia-acs-subcontracting"
      ]
    },
    {
      "id": "pay-basis-risk",
      "severity": "review",
      "when": {
        "all": [
          {
            "q": "fees.basis",
            "in": [
              "hour",
              "day"
            ]
          },
          {
            "not": {
              "assessment": "financial_risk",
              "eq": "yes"
            }
          }
        ]
      },
      "message": "Paying by the hour or day with no real financial risk is a sign of employment or worker status. Check that the status outcome reflects this, and that the National Minimum Wage would be met if the person is a worker.",
      "jump": {
        "question": "fees.basis"
      },
      "law": [
        "employment-status-services"
      ]
    },
    {
      "id": "equipment-company",
      "severity": "review",
      "when": {
        "assessment": "equipment",
        "eq": "company"
      },
      "message": "The assessment records that the Company or client provides the equipment. Make sure the equipment answers list those items, so the agreement matches what happens, and check this against the status outcome.",
      "jump": {
        "question": "equipment.company"
      },
      "law": [
        "sia-hmrc-security-operatives"
      ]
    },
    {
      "id": "security-hmrc-guidance",
      "severity": "note",
      "when": {
        "q": "services.licensable",
        "eq": "yes"
      },
      "message": "Read the SIA and HMRC guidance 'Learn how HMRC rules apply to the security operatives you deploy' and keep a record of how this engagement meets it.",
      "jump": {
        "assessment": true
      },
      "law": [
        "sia-hmrc-security-operatives"
      ]
    },
    {
      "id": "ni-status",
      "severity": "note",
      "when": {
        "jurisdiction": "ni"
      },
      "message": "In Northern Ireland, employment and worker rights come from the Employment Rights (Northern Ireland) Order 1996, and the Labour Relations Agency gives guidance. Tax status rules are UK-wide.",
      "jump": {
        "assessment": true
      },
      "law": [
        "employment-status-services"
      ]
    }
