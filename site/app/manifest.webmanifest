{
  "id": "/app/",
  "name": "Orb Security",
  "short_name": "Orb",
  "description": "Rotas, clock-in, incidents, timesheets, pay and invoices for security companies, their officers and venues.",
  "lang": "en-GB",
  "dir": "ltr",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2F4F7",
  "theme_color": "#F2F4F7",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/app/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Clock in", "short_name": "Clock in", "description": "Clock in or out, or open Live operations", "url": "/app/open?to=clock", "icons": [{ "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Rota", "short_name": "Rota", "description": "Shifts and the rota", "url": "/app/open?to=rota", "icons": [{ "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Incidents", "short_name": "Incidents", "description": "Report or review incidents", "url": "/app/open?to=incidents", "icons": [{ "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "screenshots": [
    { "src": "/app/help/pwa-phone.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "An officer's home screen" },
    { "src": "/app/help/pwa-desktop.png", "sizes": "1440x900", "type": "image/png", "form_factor": "wide", "label": "The company dashboard" }
  ]
}
